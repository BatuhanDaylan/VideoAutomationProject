# =========================================
# Video Automation System — Environment Variables
# =========================================
# Bu dosyayı kopyalayıp .env olarak kaydedin ve anahtarlarınızı girin.
# .env dosyası .gitignore'da olmalıdır!

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Pexels (Stok Video) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Apify (TikTok + Instagram Scraping) ---
APIFY_API_TOKEN=your_apify_api_token_here

# --- AI Video Üretimi (aimlapi.com — şu an Kling AI, config ile başka modele geçilebilir) ---
AI_VIDEO_API_TOKEN=your_aimlapi_token_here

# --- YouTube Data API v3 (Trend Scraping) ---
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# --- YouTube (OAuth 2.0 — video upload, ayrı amaç) ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# --- Telegram (Bildirim) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Güvenlik ---
ENCRYPTION_MASTER_KEY=your_random_master_key_here
