{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=videoautomation.db"
  },
  "ApiKeys": {
    "GeminiApiKey": "",
    "PexelsApiKey": "",
    "ApifyApiToken": "",
    "AiVideoApiToken": "",
    "TelegramBotToken": "",
    "TelegramChatId": "",
    "YouTubeApiKey": ""
  },
  "YouTube": {
    "ClientId": "",
    "ClientSecret": "",
    "ApplicationName": "VideoAutomation",
    "TokenStorePath": "assets/youtube-token"
  },
  "Scraping": {
    "MaxResultsPerPlatform": 5,
    "CrossPlatformSimilarityThreshold": 0.3,
    "YouTube": {
      "MaxSeedQueriesPerRun": 5,
      "MaxResultsPerQuery": 50
    },
    "Apify": {
      "TikTokActorId": "clockworks/tiktok-scraper",
      "InstagramActorId": "apify/instagram-hashtag-scraper",
      "MaxHashtagsPerRun": 2
    },
    "LanguageFilter": {
      "Enabled": true
    },
    "YouTubeTranscript": {
      "Languages": [
        "tr",
        "en"
      ],
      "PythonExecutable": "python",
      "MaxCharsInPrompt": 3000
    },
    "TrendPotential": {
      "MinViewVelocityPerHour": {
        "YouTube": 800,
        "TikTok": 1500,
        "Instagram": 0
      }
    },
    "Virality": {
      "BaselineViewsByPlatform": {
        "YouTube": 2000,
        "TikTok": 20000,
        "Instagram": 15000
      },
      "VelocityCapPerHourByPlatform": {
        "YouTube": 3000,
        "TikTok": 20000,
        "Instagram": 10000
      },
      "OutlierMultiplierCapByPlatform": {
        "YouTube": 5,
        "TikTok": 20,
        "Instagram": 20
      }
    },
    "SeedHashtagsByCategory": {
      "Entertainment": [
        "eglence",
        "viral",
        "trend"
      ],
      "Education": [
        "egitim",
        "ogren",
        "bilgi"
      ],
      "News": [
        "haber",
        "gundem",
        "sondakika"
      ],
      "Technology": [
        "teknoloji",
        "yapayzeka",
        "yazilim"
      ],
      "Gaming": [
        "oyun",
        "gaming",
        "oyunizle"
      ],
      "Music": [
        "muzik",
        "sarki",
        "klip"
      ],
      "Sports": [
        "spor",
        "futbol",
        "basketbol"
      ],
      "Comedy": [
        "komedi",
        "komik",
        "kesfet"
      ],
      "Lifestyle": [
        "yasam",
        "lifestyle",
        "vlog"
      ],
      "Motivation": [
        "motivasyon",
        "basari",
        "ilham"
      ]
    }
  },
  "AI": {
    "GeminiModel": "gemini-flash-latest",
    "ScriptTemperature": 0.7,
    "AnalysisTemperature": 0.4
  },
  "Pipeline": {
    "Region": "TR",
    "Language": "tr",
    "MaxTrendsPerRun": 5,
    "MinAiFeasibilityScore": 60,
    "DefaultVisualMode": "AIGenerated",
    "DefaultTemplateId": 1,
    "OutputDirectory": "output",
    "AssetsDirectory": "assets",
    "CronSchedule": "0 9 * * *",
    "DailyScheduleEnabled": false,
    "TargetVideoSeconds": 35
  },
  "Video": {
    "Width": 1080,
    "Height": 1920,
    "TargetDurationSeconds": 60,
    "DefaultTTSVoice": "tr-TR-AhmetNeural",
    "DefaultTTSRate": 1.0,
    "BGMVolume": 0.15,
    "SubtitleFontSize": 48,
    "UseABSplit": true,
    "UseAvatarInjection": false,
    "SubtitlesInNativeAudioMode": false
  },
  "Media": {
    "SceneClipSecondsDefault": 8,
    "TransitionDurationSeconds": 0.5,
    "SilenceThresholdDb": -40,
    "Pexels": {
      "Orientation": "portrait"
    },
    "AiVideo": {
      "Model": "klingai/v2-master-text-to-video",
      "DurationSeconds": 5,
      "PollIntervalSeconds": 10,
      "MaxPollAttempts": 40
    },
    "Veo": {
      "Model": "veo-3.1-generate-preview",
      "AspectRatio": "9:16",
      "DurationSeconds": 8,
      "Resolution": "720p",
      "PollIntervalSeconds": 10,
      "MaxPollAttempts": 40
    },
    "YouTube": {
      "PrivacyStatus": "private",
      "CategoryId": "24"
    },
    "EdgeTts": {
      "PythonExecutable": "python"
    },
    "Avatar": {
      "DefaultAvatarPath": "assets/avatars/default.mp4"
    }
  },
  "Security": {
    "EncryptionMasterKey": "CHANGE-THIS-TO-A-RANDOM-KEY-IN-PRODUCTION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Telegram": {
    "_comment_PeakHours": "hour:windowHours — her parti bir önceki partiden bu yana olan yayın penceresini tarar (trend kaçmasın).",
    "PeakHours": "12:15,19:7,21:2",
    "ManualWindowHours": 3,
    "CandidatesPerBatch": 5,
    "CandidatePublishedWithinHours": 3
  }
}